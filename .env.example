# Public project URL and anon/publishable key only. NEVER put a service_role key here.
# Leave both unset to use the clearly labeled local, single-device demo.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional: deployed HTTPS web app used by native room browser links.
EXPO_PUBLIC_WEB_APP_URL=

# AI themes: set OPENAI_API_KEY only in Supabase Edge Function secrets.
# OpenAI and service_role credentials must never go in this client .env file.
