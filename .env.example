# Local demo: leave all Appwrite values empty. No backend calls are made.
EXPO_PUBLIC_BACKEND=demo
# To use Appwrite, choose appwrite and fill all three public values below.
# Partial configuration shows an error; it never falls back to demo.
EXPO_PUBLIC_APPWRITE_ENDPOINT=
EXPO_PUBLIC_APPWRITE_PROJECT_ID=
EXPO_PUBLIC_APPWRITE_FUNCTION_ID=

# Optional deployed web URL for native room links (live rooms not ported yet).
EXPO_PUBLIC_WEB_APP_URL=

# NEVER put Appwrite API keys, session secrets, or OPENAI_API_KEY in EXPO_PUBLIC_*.
# This migration does not activate Supabase even if old Supabase env values remain.

# Optional AI: configure OPENAI_API_KEY only in Appwrite Function secrets.
